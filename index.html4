<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#102a43">
<title>Salah Recovery Pro</title>
<style>
:root{--bg:#f5f7fa;--card:#fff;--text:#142235;--muted:#718096;--brand:#102a43;--brand2:#2f6f95;--soft:#edf3f7;--line:#e3e8ee;--good:#2d8a59;--warn:#c27a18;--bad:#b63c45;--shadow:0 8px 28px #102a4310}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}.app{max-width:560px;margin:auto;min-height:100vh;padding-bottom:92px}button,input,select,textarea{font:inherit}button{cursor:pointer}.top{padding:18px 16px 8px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(12px);z-index:4}.title{font-size:23px;font-weight:800}.muted{color:var(--muted);font-size:13px}.card{background:var(--card);margin:10px 14px;padding:16px;border-radius:20px;box-shadow:var(--shadow);border:1px solid color-mix(in srgb,var(--line) 65%,transparent)}.hero{background:linear-gradient(135deg,#102a43,#285b78);color:white;overflow:hidden;position:relative}.hero:after{content:"☾";position:absolute;right:20px;top:10px;font-size:74px;opacity:.08}.hero .muted{color:#d4e3ed}.row{display:flex;align-items:center;justify-content:space-between;gap:10px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{background:var(--soft);border-radius:15px;padding:12px;text-align:center}.stat b{font-size:21px;display:block}.progress,.bar{height:9px;background:#e5eaf0;border-radius:99px;overflow:hidden}.progress i,.bar i{display:block;height:100%;background:var(--brand2);border-radius:99px}.prayer{display:flex;align-items:center;justify-content:space-between;padding:14px 2px;border-bottom:1px solid var(--line)}.prayer:last-child{border-bottom:0}.pname{display:flex;align-items:center;gap:11px}.icon{width:38px;height:38px;border-radius:13px;background:var(--soft);display:grid;place-items:center;font-size:18px}.status{font-size:12px;font-weight:750}.done{color:var(--good)}.missed{color:var(--bad)}.planned{color:var(--brand2)}.upcoming{color:var(--muted)}.btn{border:0;border-radius:13px;padding:10px 13px;font-weight:750}.primary{background:var(--brand);color:white}.soft{background:var(--soft);color:var(--brand)}.danger{background:var(--bad);color:white}.gold{background:#b8860b;color:#fff}.mini{padding:7px 9px;font-size:12px}.count{font-size:25px;font-weight:850}.countdown{font-size:13px;color:#d9e5ed;margin-top:5px}.alarm{border:1px dashed #9eb7c8;background:var(--soft);border-radius:15px;padding:13px}.tabs{display:flex;gap:7px;overflow:auto;padding:4px 14px 9px}.tabs button{white-space:nowrap;border:0;border-radius:20px;padding:8px 13px;background:var(--soft);color:var(--muted)}.tabs .sel{background:var(--brand);color:#fff}.nav{position:fixed;bottom:0;left:0;right:0;max-width:560px;margin:auto;background:color-mix(in srgb,var(--card) 94%,transparent);backdrop-filter:blur(14px);border-top:1px solid var(--line);display:flex;justify-content:space-around;padding:7px 3px calc(7px + env(safe-area-inset-bottom));z-index:10}.nav button{background:none;border:0;color:var(--muted);font-size:10px;padding:4px}.nav button.active{color:var(--brand);font-weight:800}.nav span{display:block;font-size:20px;margin-bottom:2px}.modal{position:fixed;inset:0;background:#0009;display:grid;align-items:end;z-index:30}.sheet{background:var(--card);border-radius:25px 25px 0 0;padding:22px;max-width:560px;width:100%;margin:auto;max-height:90vh;overflow:auto}.actions{display:flex;gap:8px;margin-top:13px}.actions>*{flex:1}select,input,textarea{width:100%;padding:12px;border:1px solid var(--line);border-radius:13px;background:var(--card);color:var(--text);margin-top:6px}textarea{min-height:90px}.option{padding:11px;border:1px solid var(--line);border-radius:12px;margin:6px 0}.option.sel{border-color:var(--brand2);background:var(--soft)}.toggle{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid var(--line)}.toggle:last-child{border:0}.switch{width:48px;height:28px;border:0;border-radius:99px;background:#c6cdd5;position:relative}.switch i{position:absolute;width:20px;height:20px;border-radius:50%;background:#fff;left:4px;top:4px;transition:.2s}.switch.on{background:var(--brand)}.switch.on i{left:24px}.feature{display:flex;gap:12px;align-items:center;padding:13px 0;border-bottom:1px solid var(--line)}.feature:last-child{border:0}.featureIcon{width:42px;height:42px;border-radius:14px;background:var(--soft);display:grid;place-items:center;font-size:20px}.empty{text-align:center;padding:30px;color:var(--muted)}.badge{display:inline-block;padding:5px 8px;border-radius:99px;background:var(--soft);font-size:11px;font-weight:750}.qibla{width:190px;height:190px;margin:10px auto;border:12px solid var(--soft);border-radius:50%;display:grid;place-items:center;position:relative}.needle{font-size:58px;transform-origin:center;transition:transform .5s}.compassN{position:absolute;top:3px;font-weight:800}.tasbih{font-size:64px;text-align:center;font-weight:900;padding:12px}.tap{width:180px;height:180px;border-radius:50%;border:0;background:var(--brand);color:#fff;font-size:20px;font-weight:850;box-shadow:0 12px 30px #102a4330}.toast{position:fixed;left:50%;bottom:92px;transform:translateX(-50%);background:#172a3a;color:#fff;padding:11px 15px;border-radius:13px;z-index:50;font-size:13px;box-shadow:0 10px 30px #0003}.dark{--bg:#0d131d;--card:#151d29;--text:#edf2f7;--muted:#9ca9b8;--brand:#8fc2df;--brand2:#74a9c8;--soft:#202c3a;--line:#2c3948;--good:#63c58b;--warn:#e2ad56;--bad:#ef777d}.dark .primary{color:#07121d;background:#8fc2df}.dark .soft{color:#e9f3f9}.dark .hero{background:linear-gradient(135deg,#162c40,#23465c)}.dark .nav{background:color-mix(in srgb,var(--card) 94%,transparent)}.small{font-size:11px}.center{text-align:center}.rtl{direction:rtl}.pillrow{display:flex;flex-wrap:wrap;gap:7px}.hide{display:none!important}
</style>
</head>
<body><div id="root"></div>
<script>
const PR=["Fajr","Dhuhr","Asr","Maghrib","Isha"], ICON={Fajr:"🌅",Dhuhr:"☀️",Asr:"🌤️",Maghrib:"🌇",Isha:"🌙"};
const CITY={Karachi:[24.8607,67.0011,"Pakistan"],Lahore:[31.5204,74.3587,"Pakistan"],Islamabad:[33.6844,73.0479,"Pakistan"],Makkah:[21.4225,39.8262,"Saudi Arabia"],Madinah:[24.4672,39.6024,"Saudi Arabia"],Riyadh:[24.7136,46.6753,"Saudi Arabia"],Dubai:[25.2048,55.2708,"UAE"],London:[51.5074,-.1278,"UK"],New York:[40.7128,-74.006,"USA"]};
const METHODS={Karachi:1,MWL:3,Egypt:5,UmmAlQura:4,Tehran:7,Dubai:16,Turkey:13,Singapore:11};
const REASONS=["Overslept","Forgot","Work","School","Travel","Health/personal circumstances","Family responsibilities","Lost track of time","No suitable place","Low motivation","Intentionally delayed","Other"];
const DUAS=[
["After Fard prayer","Astaghfirullah ×3","سُبْحَانَ اللَّهِ وَالْحَمْدُ لِلَّهِ وَاللَّهُ أَكْبَرُ"],
["Before sleeping","Ayat al-Kursi","Recite Ayat al-Kursi before sleep."],
["Morning","Allahumma inni as'aluka ilman nafi'an","اللَّهُمَّ إِنِّي أَسْأَلُكَ عِلْمًا نَافِعًا"],
["For consistency","Rabbana la tuzigh qulubana","رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا"],
["When you miss a prayer","Turn back to Allah","Make sincere tawbah and take the next practical step."]
];
let d=JSON.parse(localStorage.getItem("salah_recovery_pro_v5")||"null")||{
onboard:false,city:"Karachi",lat:null,lon:null,madhab:"Hanafi",method:1,theme:"light",
records:[],alarms:true,adhan:true,lead:10,fajrAdhan:true,focus:false,sound:"adhan",
prayers:{},notes:[],tasbih:0,streakBest:0,lastFetch:"",qibla:null,customTune:0
};
d.records ||= []; d.prayers ||= {}; d.notes ||= []; d.lead=Number.isFinite(d.lead)?d.lead:10;
let page="today",modal=null,selected=null,reason="",toastTimer=null,audioCtx=null,lastAlarmKey="",lastAdhanKey="",wake=null;

function save(){localStorage.setItem("salah_recovery_pro_v5",JSON.stringify(d))}
function todayKey(){return new Date().toLocaleDateString("en-CA")}
function fmt(x){return new Date(x+"T00:00:00").toLocaleDateString(undefined,{weekday:"short",month:"short",day:"numeric",year:"numeric"})}
function esc(x){return String(x??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
function toast(x){clearTimeout(toastTimer);let e=document.createElement("div");e.className="toast";e.textContent=x;document.body.appendChild(e);toastTimer=setTimeout(()=>e.remove(),2600)}
function notify(t,b){if("Notification"in window&&Notification.permission==="granted")try{new Notification(t,{body:b,tag:t})}catch(e){}}
function prime(){try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();if(audioCtx.state==="suspended")audioCtx.resume()}catch(e){}}
function beep(freq=880,dur=.8){prime();if(!audioCtx)return;let o=audioCtx.createOscillator(),g=audioCtx.createGain();o.frequency.value=freq;o.connect(g);g.connect(audioCtx.destination);let t=audioCtx.currentTime;g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.2,t+.03);g.gain.exponentialRampToValueAtTime(.0001,t+dur);o.start(t);o.stop(t+dur+.02)}
const ADHAN="https://github.com/AalianKhan/adhans/raw/master/adhan.mp3";
const FAJR="https://github.com/AalianKhan/adhans/raw/master/adhan_fajr.mp3";
function playAdhan(fajr=false){let a=new Audio(fajr?FAJR:ADHAN);a.volume=.9;a.play().catch(()=>toast("Audio blocked — tap Test Adhan once in Settings."))}
async function enableAlarms(){d.alarms=true;save();prime();if("Notification"in window&&Notification.permission==="default")try{await Notification.requestPermission()}catch(e){};toast("Reminders enabled");render()}
function testAlarm(){beep();notify("🔔 Salah reminder","Prayer time is approaching.");toast("Alarm tested")}
function testAdhan(){prime();playAdhan();toast("Adhan test started")}
function timeObj(t,day=todayKey()){let m=String(t).match(/(\d{1,2}):(\d{2})/);if(!m)return null;let h=+m[1],mi=+m[2];let x=new Date(day+"T00:00:00");x.setHours(h,mi,0,0);return x}
function localName(){return d.city+(d.lat? " • GPS": "")}
function getCoords(){return d.lat&&d.lon?[d.lat,d.lon]:CITY[d.city]?.slice(0,2)||CITY.Karachi.slice(0,2)}
function methodId(){return d.method||1}
async function fetchTimes(silent=false){
 let [lat,lon]=getCoords(),dt=new Date(),date=`${String(dt.getDate()).padStart(2,"0")}-${String(dt.getMonth()+1).padStart(2,"0")}-${dt.getFullYear()}`;
 try{
  let url=`https://api.aladhan.com/v1/timings/${date}?latitude=${lat}&longitude=${lon}&method=${methodId()}&school=${d.madhab==="Hanafi"?1:0}&tune=0,0,0,${d.customTune||0},0,0,0,0,0`;
  let r=await fetch(url);let j=await r.json();let t=j?.data?.timings;
  if(!t)throw Error("No timing data");
  d.prayers={Fajr:t.Fajr,Dhuhr:t.Dhuhr,Asr:t.Asr,Maghrib:t.Maghrib,Isha:t.Isha,Sunrise:t.Sunrise,Sunset:t.Sunset,Midnight:t.Midnight};
  d.hijri=j.data.date.hijri;d.greg=j.data.date.gregorian;d.lastFetch=Date.now();save();render();if(!silent)toast("Prayer times updated");
 }catch(e){if(!silent)toast("Could not update online times; using saved/default times.");if(!d.prayers.Fajr)fallbackTimes()}
}
function fallbackTimes(){let x={Karachi:["05:10","12:45","16:10","18:55","20:25"],Lahore:["05:00","12:35","16:00","18:45","20:15"],Islamabad:["04:55","12:30","15:55","18:40","20:10"],Makkah:["04:30","12:15","15:45","18:30","20:00"],Madinah:["04:45","12:20","15:50","18:35","20:05"],Riyadh:["04:15","12:00","15:30","18:15","19:45"],Dubai:["04:55","12:25","15:55","18:40","20:10"],London:["05:45","13:00","16:15","19:00","20:30"],"New York":["05:00","12:55","16:45","19:30","21:00"]};let a=x[d.city]||x.Karachi;d.prayers=Object.fromEntries(PR.map((p,i)=>[p,a[i]]))}
function t(p){return d.prayers[p]||fallbackTimes()||"--:--"}
function rec(p,day=todayKey()){return d.records.find(x=>x.date===day&&x.prayer===p)}
function setRec(p,status,r=""){d.records=d.records.filter(x=>!(x.date===todayKey()&&x.prayer===p));d.records.push({date:todayKey(),prayer:p,status,recovery:"none",reason:r,time:Date.now()});save();render()}
function status(p){let r=rec(p);if(r)return r.status==="completed"?"completed":r.recovery==="completed"?"recovered":r.recovery==="planned"?"planned":"missed";let x=timeObj(t(p));return x&&x<new Date()?"missed":"upcoming"}
function completed(){return PR.filter(p=>{let s=status(p);return s==="completed"||s==="recovered"}).length}
function missed(){return d.records.filter(x=>x.status==="missed")}
function nextPrayer(){let now=new Date(),best=null;PR.forEach(p=>{let x=timeObj(t(p));if(x&&x>now&&(!best||x<best.time))best={p,time:x}});return best}
function countdown(){let n=nextPrayer();if(!n)return"All prayers have passed — tomorrow is next.";let ms=n.time-new Date(),m=Math.max(0,Math.floor(ms/60000)),h=Math.floor(m/60);m%=60;return`${n.p} in ${h?`${h}h `:""}${m}m`}
function streak(){let set=new Set(d.records.filter(x=>x.status==="completed").map(x=>x.date));let cur=0,dt=new Date();while(true){let k=dt.toLocaleDateString("en-CA");if(!set.has(k))break;cur++;dt.setDate(dt.getDate()-1)}return cur}
function score(){let total=d.records.length,good=d.records.filter(x=>x.status==="completed").length;return total?Math.round(good/total*100):0}
function qiblaBearing(lat,lon){let ka=21.4225*Math.PI/180,ko=39.8262*Math.PI/180,la=lat*Math.PI/180,lo=lon*Math.PI/180;let y=Math.sin(ko-lo),x=Math.cos(la)*Math.tan(ka)-Math.sin(la)*Math.cos(ko-lo);return(Math.atan2(y,x)*180/Math.PI+360)%360}
function locationName(){return d.lat?`${d.city} • GPS location`:`${d.city} • saved city`}
function nav(x){page=x;modal=null;render();window.scrollTo(0,0)}
function shell(content){return`<div class="app"><header class="top"><div><div class="title">Salah Recovery <span class="badge">PRO</span></div><div class="muted">${new Date().toLocaleDateString(undefined,{weekday:"long",month:"short",day:"numeric"})} · ${esc(locationName())}</div></div><button class="btn soft mini" onclick="toggleTheme()">${d.theme==="dark"?"☀️":"🌙"}</button></header>${content}<nav class="nav">${[["today","🏠","Home"],["recovery","🤲","Recovery"],["tools","🧭","Tools"],["insights","📊","Insights"],["settings","⚙️","Settings"]].map(a=>`<button class="${page===a[0]?"active":""}" onclick="nav('${a[0]}')"><span>${a[1]}</span>${a[2]}</button>`).join("")}</nav>${modalHtml()}</div>`}
function today(){
 let c=completed(),pct=Math.round(c/5*100),n=nextPrayer(),st=streak(),sc=score();
 return `<section class="card hero"><div class="muted">Today’s Salah Journey</div><h2 style="font-size:31px;margin-top:3px">${c}/5</h2><div class="progress"><i style="width:${pct}%"></i></div><div style="margin-top:8px">${pct}% complete · ${st?`🔥 ${st} day streak`:"Start your streak today"}</div><div class="muted" style="margin-top:7px">Consistency score: ${sc}%</div></section>
 <section class="card"><div class="row"><div><div class="muted">NEXT PRAYER</div><b style="font-size:22px">${n?n.p:"Tomorrow"}</b><div class="muted">${n?t(n.p):"Schedule complete"}</div><div class="countdown" id="countdown">${countdown()}</div></div><div style="text-align:right"><div class="count">${n?"⏳":"✓"}</div><button class="btn soft mini" onclick="fetchTimes()">↻ Refresh</button></div></div></section>
 <section class="card alarm"><div class="row"><div><b>🔔 Smart reminders</b><div class="muted">${d.alarms?`${d.lead} min before · ${d.adhan?"Adhan at time":"silent at time"}`:"Reminders are off"}</div></div><button class="btn ${d.alarms?"primary":"soft"} mini" onclick="enableAlarms()">${d.alarms?"Enabled":"Enable"}</button></div></section>
 <section class="card"><div class="row"><h3>Today’s prayers</h3><span class="badge">${d.lastFetch?"Live times":"Fallback times"}</span></div>${PR.map(p=>{let s=status(p),lab=s==="completed"?"Completed ✓":s==="recovered"?"Recovered ✓":s==="planned"?"Recovery planned":s==="missed"?"Missed":"Upcoming";return`<div class="prayer" onclick="openPrayer('${p}')"><div class="pname"><div class="icon">${ICON[p]}</div><div><b>${p}</b><div class="muted">${t(p)}</div></div></div><span class="status ${s==="completed"?"done":s==="missed"?"missed":s==="upcoming"?"upcoming":"planned"}">${lab}</span></div>`}).join("")}</section>
 <section class="card"><div class="row"><div><b>Quick actions</b><div class="muted">Small actions, big consistency.</div></div></div><div class="grid2" style="margin-top:10px"><button class="btn soft" onclick="openNote()">📝 Daily reflection</button><button class="btn soft" onclick="nav('tools')">🧭 Qibla & Tasbih</button></div></section>`;
}
function openPrayer(p){selected=p;reason=rec(p)?.reason||"";modal="prayer";render()}
function recovery(){
 let all=missed().sort((a,b)=>b.date.localeCompare(a.date)),pending=all.filter(x=>x.recovery!=="completed"),done=all.filter(x=>x.recovery==="completed");
 return `<h2 style="padding:10px 14px 0">Recovery Center</h2><p class="muted" style="padding:4px 14px 8px">A calm, private way to organize missed prayers without guilt.</p>
 <section class="card hero"><div class="muted">Recovery progress</div><h2>${done.length}/${all.length}</h2><div class="progress"><i style="width:${all.length?done.length/all.length*100:0}%"></i></div><div style="margin-top:8px">${pending.length?`${pending.length} still need attention`:"No pending recovery items 🎉"}</div></section>
 ${!all.length?`<div class="card empty">🎉 No missed prayers recorded.<br><span class="muted">Keep protecting the next prayer.</span></div>`:`<section class="card">${all.map(r=>`<div class="prayer"><div><b>${r.prayer}</b><div class="muted">${fmt(r.date)} · ${esc(r.reason||"No reason")}</div><span class="status ${r.recovery==="completed"?"done":"planned"}">${r.recovery==="completed"?"Recovered ✓":"Needs recovery"}</span></div>${r.recovery==="completed"?`<span>✓</span>`:`<div style="text-align:right"><button class="btn soft mini" onclick="recover('${r.date}','${r.prayer}','planned')">Plan</button><button class="btn primary mini" onclick="recover('${r.date}','${r.prayer}','completed')">Done</button></div>`}</div>`).join("")}</section>`}
function recover(day,p,mode){let r=d.records.find(x=>x.date===day&&x.prayer===p);if(r){r.recovery=mode;save();render();toast(mode==="completed"?"Recovery marked complete":"Recovery plan saved")}}
function tools(){
 let [lat,lon]=getCoords(),bearing=qiblaBearing(lat,lon),angle=d.qibla||bearing;
 return `<h2 style="padding:10px 14px 0">Tools</h2><div class="tabs"><button class="sel" onclick="toolTab='qibla';render()">🧭 Qibla</button><button onclick="toolTab='tasbih';render()">📿 Tasbih</button><button onclick="toolTab='duas';render()">🤲 Duas</button></div>${toolTab==="tasbih"?tasbih():toolTab==="duas"?duas():qibla(bearing)}`;
}
let toolTab="qibla";
function qibla(b){return`<section class="card center"><div class="muted">QIBLA DIRECTION</div><h2>${Math.round(b)}° from North</h2><div class="qibla"><div class="compassN">N</div><div class="needle" style="transform:rotate(${b}deg)">↑</div></div><p class="muted">${d.lat?`Based on your GPS coordinates.`:"Using your selected city. Enable GPS for a more precise bearing."}</p><button class="btn primary" onclick="getGPS()">📍 Use my location</button></section><section class="card"><h3>How it helps</h3><p class="muted" style="margin-top:7px">The direction is calculated as the initial bearing from your location to the Kaaba in Makkah. A phone compass can be used alongside this direction.</p></section>`}
function tasbih(){return`<section class="card center"><div class="muted">DIGITAL TASBIH</div><div class="tasbih">${d.tasbih||0}</div><button class="tap" onclick="d.tasbih=(d.tasbih||0)+1;save();render()">Tap to count</button><div class="actions"><button class="btn soft" onclick="d.tasbih=0;save();render()">Reset</button><button class="btn primary" onclick="navigator.vibrate?.([30,20,30])">Vibrate</button></div></section><section class="card"><div class="row"><b>Suggested cycle</b><span class="badge">33 × 3</span></div><p class="muted" style="margin-top:7px">Use the counter for your personal dhikr routine.</p></section>`}
function duas(){return`<section class="card">${DUAS.map(x=>`<div class="feature"><div class="featureIcon">🤲</div><div><b>${esc(x[0])}</b><div style="margin-top:4px">${esc(x[1])}</div><div class="muted rtl" style="margin-top:5px">${esc(x[2])}</div></div></div>`).join("")}</section>`}
function insights(){
 let rs=d.records, by=Object.fromEntries(PR.map(p=>[p,{c:0,m:0}]));rs.forEach(r=>{if(by[r.prayer])r.status==="completed"?by[r.prayer].c++:r.status==="missed"&&by[r.prayer].m++});
 let top=Object.entries(by).map(([p,x])=>[p,x.c+x.m?Math.round(x.c/(x.c+x.m)*100):0]).sort((a,b)=>b[1]-a[1]);let reasonCounts={};rs.filter(x=>x.status==="missed").forEach(x=>reasonCounts[x.reason]=(reasonCounts[x.reason]||0)+1);let obstacle=Object.entries(reasonCounts).sort((a,b)=>b[1]-a[1])[0];
 return`<h2 style="padding:10px 14px">Insights</h2><section class="card"><div class="grid3"><div class="stat"><b>${score()}%</b><span class="muted">Score</span></div><div class="stat"><b>${streak()}</b><span class="muted">Current streak</span></div><div class="stat"><b>${missed().length}</b><span class="muted">Missed logged</span></div></div></section><section class="card"><h3>Prayer-by-prayer</h3>${top.map(x=>`<div style="margin:15px 0"><div class="row"><span>${x[0]}</span><b>${x[1]}%</b></div><div class="bar" style="margin-top:6px"><i style="width:${x[1]}%"></i></div></div>`).join("")}</section>${obstacle?`<section class="card"><h3>🧠 Your biggest obstacle</h3><p style="margin-top:7px"><b>${esc(obstacle[0])}</b> · ${obstacle[1]} logged time${obstacle[1]>1?"s":""}</p><p class="muted" style="margin-top:5px">Try one tiny environmental change before the next prayer.</p></section>`:""}<section class="card"><h3>🎯 Smart challenge</h3><p style="margin:7px 0 12px">Your next upgrade is not perfection. Protect the <b>${top[0]?.[0]||"next"} prayer</b> today.</p><button class="btn primary" onclick="openNote('challenge')">Set my intention</button></section>`;
}
function history(){
 let days=[...new Set(d.records.map(x=>x.date))].sort().reverse();return`<h2 style="padding:10px 14px">History</h2>${days.length?days.map(day=>{let rs=d.records.filter(x=>x.date===day),c=rs.filter(x=>x.status==="completed").length,m=rs.filter(x=>x.status==="missed").length;return`<section class="card"><div class="row"><b>${fmt(day)}</b><span class="muted">${c} completed · ${m} missed</span></div><div class="muted" style="margin-top:8px">${rs.map(r=>`${r.prayer} ${r.status==="completed"?"✓":"×"}`).join(" · ")}</div></section>`}).join(""):`<div class="card empty">No history yet.</div>`}<section class="card"><button class="btn soft" style="width:100%" onclick="exportData()">⬇️ Export my backup</button></section>`;
}
function settings(){
 let loc=Object.keys(CITY).map(x=>`<option ${x===d.city?"selected":""}>${x}</option>`).join("");
 return`<h2 style="padding:10px 14px">Settings</h2><section class="card"><label>Location<select onchange="d.city=this.value;d.lat=null;d.lon=null;save();fetchTimes(true);render()">${loc}</select></label><div class="actions"><button class="btn primary" onclick="getGPS()">📍 Detect GPS</button><button class="btn soft" onclick="fetchTimes()">↻ Update times</button></div><label style="display:block;margin-top:13px">Calculation method<select onchange="d.method=+this.value;save();fetchTimes(true)"><option value="1" ${d.method==1?"selected":""}>University of Islamic Sciences, Karachi</option><option value="3" ${d.method==3?"selected":""}>Muslim World League</option><option value="4" ${d.method==4?"selected":""}>Umm Al-Qura, Makkah</option><option value="5" ${d.method==5?"selected":""}>Egyptian General Authority</option><option value="7" ${d.method==7?"selected":""}>Tehran</option><option value="13" ${d.method==13?"selected":""}>Turkey</option><option value="16" ${d.method==16?"selected":""}>Dubai</option></select></label><label style="display:block;margin-top:13px">Asr juristic school<select onchange="d.madhab=this.value;save();fetchTimes(true)"><option ${d.madhab==="Hanafi"?"selected":""}>Hanafi</option><option ${d.madhab==="Shafi"?"selected":""}>Shafi</option></select></label></section>
 <section class="card"><h3>🔔 Alarm & Adhan</h3><div class="toggle"><div><b>Pre-prayer reminder</b><div class="muted">Alarm + notification before each prayer.</div></div><button class="switch ${d.alarms?"on":""}" onclick="d.alarms=!d.alarms;save();render();if(d.alarms)enableAlarms()"><i></i></button></div><div class="toggle"><div><b>Adhan at prayer time</b><div class="muted">Uses a separate audio track.</div></div><button class="switch ${d.adhan?"on":""}" onclick="d.adhan=!d.adhan;save();render()"><i></i></button></div><div class="toggle"><div><b>Different Fajr Adhan</b><div class="muted">Use Fajr-specific audio when available.</div></div><button class="switch ${d.fajrAdhan?"on":""}" onclick="d.fajrAdhan=!d.fajrAdhan;save();render()"><i></i></button></div><label style="display:block;padding-top:12px">Reminder lead time<select onchange="d.lead=+this.value;save();render()">${[5,10,15,20,30].map(n=>`<option ${d.lead===n?"selected":""}>${n}</option>`).map((x,i)=>x.replace(">",">")).join("")}</select><span class="muted">minutes before prayer</span></label><div class="actions"><button class="btn soft" onclick="testAlarm()">🔔 Test alarm</button><button class="btn primary" onclick="testAdhan()">🕌 Test Adhan</button></div><p class="muted" style="margin-top:9px">Important: browser alarms are most reliable while the page is open. Android/iOS can suspend background web pages; a native app is needed for guaranteed locked-screen alarms.</p></section>
 <section class="card"><h3>✨ Focus mode</h3><div class="toggle"><div><b>Prayer focus</b><div class="muted">Keeps screen awake while you prepare and pray.</div></div><button class="switch ${d.focus?"on":""}" onclick="toggleFocus()"><i></i></button></div></section>
 <section class="card"><h3>💾 Your data</h3><p class="muted" style="margin:7px 0 12px">Your records stay in this browser. Export a backup before changing phones.</p><div class="grid2"><button class="btn soft" onclick="exportData()">Export</button><button class="btn soft" onclick="document.getElementById('importFile').click()">Import</button></div><input id="importFile" class="hide" type="file" accept=".json" onchange="importData(this)"></section>
 <section class="card"><h3>About this app</h3><div class="feature"><div class="featureIcon">🔐</div><div><b>Private by design</b><div class="muted">Prayer tracking is stored locally.</div></div></div><div class="feature"><div class="featureIcon">🌍</div><div><b>Live prayer times</b><div class="muted">Uses AlAdhan’s calculation API when online.</div></div></div><div class="feature"><div class="featureIcon">🧭</div><div><b>Qibla direction</b><div class="muted">Calculated toward the Kaaba from your selected location.</div></div></div></section>
 <section class="card"><button class="btn danger" style="width:100%" onclick="if(confirm('Delete all local Salah Recovery data?')){localStorage.removeItem('salah_recovery_pro_v5');location.reload()}">Delete all data</button></section>`;
}
function openNote(kind="daily"){modal="note";selected=kind;render()}
function saveNote(){let x=document.getElementById("noteText").value.trim();if(x)d.notes.push({date:todayKey(),kind:selected,text:x,time:Date.now()});save();modal=null;render();toast("Reflection saved")}
function modalHtml(){
 if(!modal)return"";
 if(modal==="prayer"){let s=status(selected);return`<div class="modal" onclick="if(event.target===this){modal=null;render()}"><div class="sheet"><div class="row"><h2>${selected}</h2><span class="badge">${t(selected)}</span></div><p class="muted" style="margin-top:7px">${s==="upcoming"?"Mark it completed after praying.":s==="missed"?"If you missed it, log the reason and create a recovery plan.":"This prayer is already tracked."}</p>${s==="upcoming"?`<div class="actions"><button class="btn soft" onclick="modal=null;render()">Cancel</button><button class="btn primary" onclick="setRec('${selected}','completed');modal=null;render();toast('Alhamdulillah — prayer completed')">Complete ✓</button></div>`:s==="missed"?`<div class="actions"><button class="btn soft" onclick="modal=null;render()">Close</button><button class="btn primary" onclick="modal='reason';render()">Log missed prayer</button></div>`:`<button class="btn soft" style="width:100%;margin-top:12px" onclick="modal=null;render()">Close</button>`}</div></div>`}
 if(modal==="reason")return`<div class="modal"><div class="sheet"><h2>What got in the way?</h2><p class="muted" style="margin:6px 0 10px">No judgement. This is for pattern awareness.</p>${REASONS.map(x=>`<div class="option ${reason===x?"sel":""}" onclick="reason='${x.replace(/'/g,"\\'")}';render()">${x}${reason===x?" ✓":""}</div>`).join("")}<div class="actions"><button class="btn soft" onclick="modal=null;render()">Cancel</button><button class="btn danger" ${reason?"":"disabled"} onclick="setRec('${selected}','missed',reason);modal=null;render();toast('Logged — recovery is available in Recovery Center')">Mark missed</button></div></div></div>`;
 if(modal==="note")return`<div class="modal"><div class="sheet"><h2>${selected==="challenge"?"🎯 Today’s intention":"📝 Daily reflection"}</h2><p class="muted" style="margin:6px 0">Keep it short and honest.</p><textarea id="noteText" placeholder="${selected==="challenge"?"Example: I will protect Maghrib today.":"What helped or challenged you today?"}"></textarea><div class="actions"><button class="btn soft" onclick="modal=null;render()">Cancel</button><button class="btn primary" onclick="saveNote()">Save</button></div></div></div>`;
}
function getGPS(){
 if(!navigator.geolocation){toast("GPS is not available in this browser");return}
 toast("Requesting your location…");navigator.geolocation.getCurrentPosition(async pos=>{d.lat=pos.coords.latitude;d.lon=pos.coords.longitude;d.city="My location";save();await fetchTimes(true);let b=qiblaBearing(d.lat,d.lon);d.qibla=b;save();render();toast("GPS location applied");},()=>toast("Location permission denied — using selected city."),{enableHighAccuracy:true,timeout:10000});
}
function toggleTheme(){d.theme=d.theme==="dark"?"light":"dark";save();render()}
async function toggleFocus(){d.focus=!d.focus;save();if(d.focus&&"wakeLock"in navigator){try{wake=await navigator.wakeLock.request("screen");toast("Focus mode on")}catch(e){toast("Focus mode on")} }else if(wake){try{await wake.release()}catch(e){}wake=null}render()}
function exportData(){let blob=new Blob([JSON.stringify(d,null,2)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=`salah-recovery-backup-${todayKey()}.json`;a.click();URL.revokeObjectURL(a.href);toast("Backup exported")}
function importData(inp){let f=inp.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let x=JSON.parse(r.result);if(!x||!Array.isArray(x.records))throw 0;d={...d,...x};save();render();toast("Backup imported")}catch(e){toast("Invalid backup file")}};r.readAsText(f)}
function checkAlarms(){
 if(!d.alarms)return;let now=new Date(),day=todayKey();
 PR.forEach(p=>{let x=timeObj(t(p));if(!x)return;let diff=x-now,pre=day+"-pre-"+p,ad=day+"-ad-"+p;
 if(diff>0&&diff<=d.lead*60000&&lastAlarmKey!==pre){lastAlarmKey=pre;beep(880,.9);notify("🔔 "+p+" soon",`${p} is in about ${Math.max(1,Math.ceil(diff/60000))} minutes.`)}
 if(Math.abs(diff)<=30000&&lastAdhanKey!==ad){lastAdhanKey=ad;notify("🕌 "+p,`It is time for ${p}.`);if(d.adhan)playAdhan(p==="Fajr"&&d.fajrAdhan)}})
}
function onboarding(){return`<div style="min-height:100vh;display:grid;place-items:center;padding:22px"><section class="card" style="margin:0;width:100%;padding:28px;text-align:center"><div style="font-size:58px">🤲</div><h1 style="margin:10px 0 7px">Salah Recovery <span class="badge">PRO</span></h1><p class="muted">A private companion for prayer consistency, missed-salah recovery, Qibla, reminders and reflection.</p><label style="display:block;text-align:left;margin-top:22px">Choose your city<select id="ocity">${Object.keys(CITY).filter(x=>x!=="New York").map(x=>`<option>${x}</option>`).join("")}</select></label><label style="display:block;text-align:left;margin-top:10px">Asr school<select id="omadhab"><option>Hanafi</option><option>Shafi</option></select></label><button class="btn primary" style="width:100%;margin-top:16px" onclick="d.city=ocity.value;d.madhab=omadhab.value;d.onboard=true;save();fetchTimes(true);render()">Begin my journey →</button><p class="small muted" style="margin-top:13px">You can change location, calculation method and alarm settings later.</p></section></div>`}
function render(){document.body.className=d.theme==="dark"?"dark":"";document.getElementById("root").innerHTML=d.onboard?shell(page==="today"?today():page==="recovery"?recovery():page==="tools"?tools():page==="insights"?insights():page==="history"?history():settings()):onboarding()}
setInterval(()=>{checkAlarms();let e=document.getElementById("countdown");if(e)e.textContent=countdown()},15000);
document.addEventListener("visibilitychange",()=>{if(!document.hidden){checkAlarms();if(d.focus&&"wakeLock"in navigator&&!wake)toggleFocus()}});
render(); if(d.onboard){if(!d.prayers.Fajr)fallbackTimes();if(!d.lastFetch||Date.now()-d.lastFetch>12*3600000)fetchTimes(true)}
</script></body></html>